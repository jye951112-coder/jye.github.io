# app.py
app_py = r'''from flask import Flask, render_template, request
import sqlite3

app = Flask(__name__)

def search_hospital(user_input):
    conn = sqlite3.connect("hospital.db")
    cursor = conn.cursor()

    query = "SELECT * FROM hospitals WHERE 1=1"

    if "牙" in user_input:
        query += " AND department='牙科'"

    if "骨" in user_input:
        query += " AND department='骨科'"

    if "兒" in user_input:
        query += " AND department='小兒科'"

    results = cursor.execute(query).fetchall()
    conn.close()
    return results

@app.route("/", methods=["GET", "POST"])
def index():
    results = []

    if request.method == "POST":
        text = request.form["search"]
        results = search_hospital(text)

    return render_template("index.html", results=results)

if __name__ == "__main__":
    app.run(debug=True)
'''
(base / "app.py").write_text(app_py, encoding="utf-8")

# db setup
db_py = r'''import sqlite3

conn = sqlite3.connect("hospital.db")
cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS hospitals(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    department TEXT,
    address TEXT
)
""")

data = [
    ("台中榮總", "骨科", "台中市西屯區"),
    ("快樂牙醫", "牙科", "台中市北區"),
    ("安心兒科", "小兒科", "台中市南屯區")
]

cursor.executemany(
    "INSERT INTO hospitals(name, department, address) VALUES (?, ?, ?)",
    data
)

conn.commit()
conn.close()

print("資料庫建立完成")
'''
(base / "create_db.py").write_text(db_py, encoding="utf-8")

